# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# JetBrains IDEs
.idea

# Added by cargo
/target

# Environment files (credentials)
.env

# macOS system files
.DS_Store

# Docs build directories
.astro/
site/
dist/

# venv files
/bin/
/lib/
pyvenv.cfg

# Log files
*.log

# Serena files
.serena

# Optional local DuckDB extension vendoring.
vendor/duckdb/extensions/

# Configuration files
configuration
# The replicator ships base and development files so `APP_ENVIRONMENT=dev cargo
# run` works out of the box. They hold the same development placeholders as the
# committed compose file; real deployments override them with `APP_`-prefixed
# environment variables.
!crates/etl-replicator/configuration/
!crates/etl-replicator/configuration/base.yaml
!crates/etl-replicator/configuration/dev.yaml

# Nix
result

# Local rust-analyzer config
.rust-analyzer.toml
